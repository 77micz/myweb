<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itcast.myweb.mapper.OrderMapper">


    <!--    查询已删除的订单-->
    <select id="selectDeletedOrders" resultType="com.itcast.myweb.domain.entity.Order">
        select * from tb_order
        <where>

            and deleted = 1
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="orderId != null">
                and id = #{orderId}
            </if>

            <if test="detailIds != null and detailIds.size() > 0">
                and id in
                <foreach item="item" collection="detailIds" separator="," open="(" close=")" index="index">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>


</mapper>
