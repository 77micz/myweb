<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itcast.myweb.mapper.PCGoodsMapper">


<!--    根据base_id查询所有goods-->
    <select id="listGoods" resultType="com.itcast.myweb.DTO.PCGoodsDTO">
        select * from pc_goods where base_id = #{baseId} and is_deleted = #{IS_NOT_DELETED}
    </select>


<!--    根据id修改商品-->
    <update id="updateGoods" parameterType="com.itcast.myweb.DTO.PCGoodsDTO">
        update pc_goods
        <set>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="stock != null">
                stock = #{stock},
            </if>
        </set>
        where id = #{id}
    </update>



</mapper>